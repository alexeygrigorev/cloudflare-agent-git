# Copy to prototype/.env (gitignored). Real environment variables override these.
# Deployed Worker URL (must be https://)
BASE_URL=https://agent-branches.cloudflare-ai-agent-de9ca0.workers.dev
# Admin bearer token (reads /cloud/budget, cleanup)
ADMIN_TOKEN=replace-with-admin-token
# Trusted runner bearer token (submits checks)
RUNNER_TOKEN=replace-with-runner-token
