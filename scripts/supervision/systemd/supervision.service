[Unit]
Description=Cloudflare Agent Git - Autonomous Supervision Service
Documentation=file:///home/alexey/git/cloudflare-agent-git/scripts/supervision/SYSTEMD-MIGRATION-RUNBOOK.md
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/alexey/git/cloudflare-agent-git
UnsetEnvironment=APLEXER_SESSION_ID APLEXER_TAG APLEXER_WORKSPACE
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/alexey/git/cloudflare-agent-git
Environment=PATH=/home/alexey/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/alexey/git/cloudflare-agent-git/scripts/supervision/systemd/launch_supervision.sh
ExecStop=/bin/bash -c "touch /home/alexey/git/cloudflare-agent-git/.local/supervision/stop; for i in {1..30}; do if ! aplexer status experiment-supervision >/dev/null 2>&1; then break; fi; sleep 1; done"
TimeoutStopSec=35s
KillMode=mixed

[Install]
WantedBy=default.target
