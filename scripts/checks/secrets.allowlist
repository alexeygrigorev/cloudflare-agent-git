# Justified exceptions for scripts/checks/secrets.sh.
# Format: <kind|*> <path-glob>   # reason (required)
# Prefer deleting the data. Add a rule only when the match is synthetic or the
# file's whole purpose is to hold detection patterns. Review in code review.
#
# The scanner and its tests contain synthetic token shapes and the private
# path/email patterns they detect.
*  scripts/checks/secrets.sh              # holds the detection patterns
*  tests/checks/secrets_test*             # synthetic fixtures, assembled at runtime
artifacts-token  artifacts-spike/docs/*                        # fetched official Cloudflare docs; synthetic example tokens (0123456789abcdef...)
artifacts-token  prototype/test/fixtures/artifacts-spike.ts    # synthetic fixture tokens (patterned hex)
private-email  demo-target/.harness/reference-solutions/*.patch  # git format-patch From: header; the address is the public git author identity, and the patch bytes must stay unchanged
private-email  prototype/test/fixtures/artifacts-spike.ts        # recorded commit fixture; the address is the public git author identity
private-home-path  live/evidence/*                  # frozen recorded run output (historical evidence), not edited after the run
private-home-path  live/README.md                   # historical run notes
private-home-path  */WORKLOG*.md                    # historical worklogs of finished spikes
private-home-path  artifacts-spike/appendix-transcript.md  # historical recorded transcript
private-home-path  tests/checks/test_publication*   # holds the leak-detection pattern and its assertions
private-home-path  website/test_history.py          # holds the leak-detection pattern and its assertions
private-home-path  website/publish_daily.py         # holds the leak-detection pattern
generic-secret-assignment  tests/test_publication_guard.py     # synthetic credentials exercising the publication guard
credential-url   tests/test_publication_guard.py               # synthetic credential URLs exercising the guard
generic-secret-assignment  tests/test_filebus_dispatcher_adversarial.py  # adversarial dummy value
generic-secret-assignment  tests/test_windows_rpc_diagnostic_driver.py   # dummy RPC test values
bearer-token     tests/test_windows_rpc_diagnostic_driver.py   # dummy bearer values in redaction tests
