+    def test_usage_honors_as_of(self):
+        status, _headers, data = self._get("/api/usage?as_of=2026-10-04T12:00:00Z")
+        self.assertEqual(status, 200)
+        payload = json.loads(data.decode("utf-8"))
+        self.assertTrue(payload["window_end"].startswith("2026-10-04T12:00:00"))
+        self.assertTrue(payload["window_start"].startswith("2026-10-03T12:00:00"))
+        self.assertIn("agent-dashboard", payload["projects"])
+
+        # Query with as_of before the event timestamp excludes the event
+        status_old, _headers_old, data_old = self._get("/api/usage?as_of=2026-10-03T10:00:00Z")
+        self.assertEqual(status_old, 200)
+        payload_old = json.loads(data_old.decode("utf-8"))
+        self.assertTrue(payload_old["unknown"])
+        self.assertEqual(len(payload_old["projects"]), 0)
+
+    def test_usage_invalid_as_of(self):
+        req = urllib.request.Request(self.base + "/api/usage?as_of=not-a-date")
+        with self.assertRaises(urllib.error.HTTPError) as ctx:
+            urllib.request.urlopen(req)
+        self.assertEqual(ctx.exception.code, 400)
+
+    def test_features_honors_as_of(self):
+        status, _headers, data = self._get("/api/features?as_of=2026-10-04T12:00:00Z")
+        self.assertEqual(status, 200)
+        payload = json.loads(data.decode("utf-8"))
+        self.assertTrue(payload["window_end"].startswith("2026-10-04T12:00:00"))
+        self.assertTrue(payload["window_start"].startswith("2026-10-03T12:00:00"))
+
+    def test_features_invalid_as_of(self):
+        req = urllib.request.Request(self.base + "/api/features?as_of=not-a-date")
+        with self.assertRaises(urllib.error.HTTPError) as ctx:
+            urllib.request.urlopen(req)
+        self.assertEqual(ctx.exception.code, 400)
+
