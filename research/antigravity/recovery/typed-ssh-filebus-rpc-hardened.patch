+
+    Per C2166: Carries only bounded, structured reasons. Never embeds tokens or details.
+    """
+
+    def __init__(
+        self,
+        message: str = "remote_auth_rejected",
+        reason: str = "remote_auth_rejected",
+        code: str = "auth_error",
+    ):
+        super().__init__(message)
+        self.reason = reason
+        self.code = code
