+function renderKanbanBoard(filteredTasks) {
+  var columns = {
+    ready: document.getElementById("col-ready-body"),
+    in_progress: document.getElementById("col-in_progress-body"),
+    review: document.getElementById("col-review-body"),
+    blocked: document.getElementById("col-blocked-body"),
+    done: document.getElementById("col-done-body")
+  };
+
+  var counts = { ready: 0, in_progress: 0, review: 0, blocked: 0, done: 0 };
+
+  TASK_STATES.forEach(function (st) {
+    if (columns[st]) columns[st].textContent = "";
+  });
+
+  filteredTasks.forEach(function (t) {
+    var st = t.state || "ready";
+    if (!columns[st]) st = "ready";
+    counts[st]++;
+    var card = renderKanbanCard(t);
+    columns[st].appendChild(card);
+  });
+
+  TASK_STATES.forEach(function (st) {
+    var countEl = document.getElementById("count-" + st);
+    if (countEl) countEl.textContent = String(counts[st]);
+    if (columns[st] && counts[st] === 0) {
+      var empty = document.createElement("p");
+      empty.className = "muted small";
+      empty.style.textAlign = "center";
+      empty.style.padding = "1rem 0";
+      empty.textContent = "No tasks in " + STATE_LABELS[st];
+      columns[st].appendChild(empty);
+    }
+  });
+}
+
+function renderTasksTable(filteredTasks) {
+  var body = document.getElementById("tasks-table-body");
+  if (!body) return;
+  body.textContent = "";
+
+  if (filteredTasks.length === 0) {
+    var tr = document.createElement("tr");
+    var td = document.createElement("td");
+    td.colSpan = 9;
+    td.className = "muted";
+    td.textContent = "No tasks match the active filters.";
+    tr.appendChild(td);
+    body.appendChild(tr);
+    return;
+  }
+
+  filteredTasks.forEach(function (t) {
+    var tr = document.createElement("tr");
+
+    function cell(txt, cls) {
+      var td = document.createElement("td");
+      td.textContent = txt;
+      if (cls) td.className = cls;
+      return td;
+    }
+
+    var tdId = document.createElement("td");
+    tdId.innerHTML = '<code>' + t.id + '</code>';
+    tr.appendChild(tdId);
+
+    tr.appendChild(cell(t.product, null));
+
+    var tdState = document.createElement("td");
+    tdState.innerHTML = '<span class="badge" style="color:' + STATE_COLORS[t.state] + '; border-color:' + STATE_COLORS[t.state] + ';">' + (STATE_LABELS[t.state] || t.state) + '</span>';
+    tr.appendChild(tdState);
+
+    var tdPrio = document.createElement("td");
+    tdPrio.innerHTML = '<span class="badge-prio prio-' + t.priority + '">' + t.priority + '</span>';
+    tr.appendChild(tdPrio);
+
+    tr.appendChild(cell(t.title || t.id, null));
+    tr.appendChild(cell(t.owner, null));
+
+    var nextOrBlocker = t.state === "blocked" ? (Array.isArray(t.blocker) ? t.blocker.join("; ") : t.blocker) : (t.next_action || "—");
+    tr.appendChild(cell(nextOrBlocker, null));
+
+    tr.appendChild(cell(fmtRelativeTime(t.last_update), null));
+
+    var tdBtn = document.createElement("td");
+    var btn = document.createElement("button");
+    btn.type = "button";
+    btn.className = "btn-small btn-secondary";
+    btn.textContent = "Details";
+    btn.addEventListener("click", function () { openTaskModal(t); });
+    tdBtn.appendChild(btn);
+    tr.appendChild(tdBtn);
+
+    body.appendChild(tr);
+  });
+}
+
+function updateTasksViews() {
+  if (!cachedTasksPayload) return;
+  var allTasks = cachedTasksPayload.tasks || [];
+  var filtered = filterTasks(allTasks);
+
+  var counter = document.getElementById("tasks-filter-counter");
+  if (counter) {
+    counter.textContent = "Showing " + filtered.length + " of " + allTasks.length + " tasks";
+  }
+
+  var kanbanView = document.getElementById("kanban-view");
+  var listView = document.getElementById("tasks-list-view");
+
+  if (currentFilter.view === "kanban") {
+    if (kanbanView) kanbanView.hidden = false;
+    if (listView) listView.hidden = true;
+    renderKanbanBoard(filtered);
+  } else {
+    if (kanbanView) kanbanView.hidden = true;
+    if (listView) listView.hidden = false;
+    renderTasksTable(filtered);
+  }
+}
