+    toggleList.addEventListener("click", function () {
+      currentFilter.view = "list";
+      toggleList.classList.add("active");
+      toggleList.setAttribute("aria-pressed", "true");
+      toggleKanban.classList.remove("active");
+      toggleKanban.setAttribute("aria-pressed", "false");
+      updateTasksViews();
+    });
+  }
+}
