+    def test_normalize_task_state(self):
+        self.assertEqual(normalize_task_state("done"), "done")
+        self.assertEqual(normalize_task_state("completed"), "done")
+        self.assertEqual(normalize_task_state("integrated"), "done")
+        self.assertEqual(normalize_task_state("running"), "in_progress")
+        self.assertEqual(normalize_task_state("in_progress"), "in_progress")
+        self.assertEqual(normalize_task_state("review"), "review")
+        self.assertEqual(normalize_task_state("blocked"), "blocked")
+        self.assertEqual(normalize_task_state("held"), "blocked")
+        self.assertEqual(normalize_task_state("ready"), "ready")
