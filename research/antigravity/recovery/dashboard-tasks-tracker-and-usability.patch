+"""
+Task tracking, normalization, and actor categorization for Agent Dashboard.
+Exposes structured task objects and separates fleet actors into persistent coordinators,
+active task workers, completed workers, and idle/blocked sessions.
+"""
+
+from __future__ import annotations
+
+import datetime
+import json
+import os
+import re
+from typing import Any, Dict, List, Optional, Set, Tuple
+
+CANONICAL_TASK_PRODUCTS = (
+    "agent-branches",
+    "agent-dashboard",
+    "quota-launcher",
+    "agent-coordination",
+    "infrastructure",
+)
+
+PRODUCT_ALIASES = {
+    "agent-branches": "agent-branches",
+    "agent_branches": "agent-branches",
+    "ab": "agent-branches",
+    "agent-dashboard": "agent-dashboard",
+    "agent_dashboard": "agent-dashboard",
+    "ad": "agent-dashboard",
+    "dashboard": "agent-dashboard",
+    "quota-launcher": "quota-launcher",
+    "agent-quota-launcher": "quota-launcher",
+    "agent_quota_launcher": "quota-launcher",
+    "launcher": "quota-launcher",
+    "agent-coordination": "agent-coordination",
+    "agent_coordination": "agent-coordination",
+    "cross-computer": "agent-coordination",
+    "cross_computer": "agent-coordination",
+    "coord": "agent-coordination",
+}
+
+VALID_TASK_STATES = ("ready", "in_progress", "review", "blocked", "done")
+
+
+def canonical_task_product(
+    raw_project: Optional[str],
+    raw_team: Optional[str] = None,
+) -> str:
+    """Map project or team ID to canonical task product."""
+    p_str = (raw_project or "").lower().strip()
+    if p_str in PRODUCT_ALIASES:
+        return PRODUCT_ALIASES[p_str]
+    t_str = (raw_team or "").lower().strip()
+    if t_str in PRODUCT_ALIASES:
+        return PRODUCT_ALIASES[t_str]
+    return "infrastructure"
+
+
+def normalize_task_state(status: Optional[str]) -> str:
+    """Normalize raw task status into standard lifecycle state."""
+    s = (status or "").lower().strip()
+    if s in ("done", "completed", "complete", "integrated", "delivered", "accepted"):
+        return "done"
+    if s in ("running", "in_progress", "working", "active"):
+        return "in_progress"
+    if s in ("review", "in_review", "under_review", "reviewing"):
+        return "review"
+    if s in ("blocked", "held", "halted", "waiting"):
+        return "blocked"
+    if s in ("ready", "queued", "backlog", "pending", "unassigned"):
+        return "ready"
+    return "ready"
+
+
+def normalize_priority(
+    raw_priority: Optional[str],
+    task_id: str,
+    state: str,
+    delivery_task_ids: Set[str],
+) -> str:
+    """Determine normalized task priority (critical, high, normal, low)."""
+    if raw_priority:
+        p = str(raw_priority).lower().strip()
+        if p in ("critical", "high", "normal", "low"):
+            return p
+    if state == "blocked":
+        return "critical" if task_id in delivery_task_ids else "high"
+    if task_id in delivery_task_ids:
+        return "high"
+    if state in ("in_progress", "review"):
+        return "high"
+    return "normal"
+
+
+def prettify_id(identifier: str) -> str:
+    """Convert a kebab-case or snake_case identifier to a human-readable title."""
+    parts = re.split(r"[-_]+", identifier.strip())
+    acronyms = {"ab": "Agent Branches", "ad": "Agent Dashboard", "rpc": "RPC", "ssh": "SSH", "cli": "CLI", "mvp": "MVP", "ui": "UI", "api": "API", "json": "JSON"}
+    formatted: List[str] = []
+    for part in parts:
+        lower = part.lower()
+        if lower in acronyms:
+            formatted.append(acronyms[lower])
+        else:
+            formatted.append(part.capitalize())
+    return " ".join(formatted)
+
+
+def format_task_title(
+    task_id: str,
+    raw_title: Optional[str],
+    backlog_source: Optional[Dict[str, Any]],
+) -> str:
+    """Derive human-friendly title for task."""
+    if raw_title and str(raw_title).strip():
+        return str(raw_title).strip()
+    if backlog_source:
+        heading = backlog_source.get("heading") or ""
+        req = backlog_source.get("requirement_summary") or ""
+        first_clause = req.split(";")[0].strip() if req else ""
+        if first_clause and len(first_clause) <= 80:
+            if heading and not first_clause.lower().startswith(heading.lower()):
+                return f"{heading}: {first_clause}"
+            return first_clause
+    return prettify_id(task_id)
+
+
+def format_task_description(
+    task: Dict[str, Any],
+    backlog_source: Optional[Dict[str, Any]],
+) -> str:
+    """Derive comprehensive human-readable description for task."""
+    if task.get("description"):
+        return str(task["description"]).strip()
+    if backlog_source and backlog_source.get("requirement_summary"):
+        return str(backlog_source["requirement_summary"]).strip()
+    if task.get("acceptance"):
+        return str(task["acceptance"]).strip()
+    if task.get("next_action"):
+        return str(task["next_action"]).strip()
+    return f"Task {task.get('id', 'unspecified')}"
+
+
+def categorize_actors(
+    registry_data: Optional[Dict[str, Any]],
+    tasks_by_id: Dict[str, Dict[str, Any]],
+) -> Dict[str, List[Dict[str, Any]]]:
+    """
+    Categorize fleet actors into four disjoint operational categories:
+    1. Persistent Coordinators (Principals, Project Heads, Orchestrators)
+    2. Active Task Workers (currently working/running tasks)
+    3. Ended/Completed Workers (finished runs or completed tasks)
+    4. Idle/Blocked Sessions (idle, queued, or blocked)
+    """
+    actors: Dict[str, Dict[str, Any]] = {}
+    reg = registry_data if isinstance(registry_data, dict) else {}
+
+    # 1. Project Heads and Principals from projects metadata
+    for p in reg.get("projects", []):
+        if not isinstance(p, dict):
+            continue
+        p_id = p.get("id")
+        p_name = p.get("name") or p_id or "Project"
+        head_tag = p.get("head_tag")
+        if head_tag:
+            actors[head_tag] = {
+                "tag": head_tag,
+                "role": "Project Head",
+                "category": "coordinators",
+                "project": canonical_task_product(p_id),
+                "session_id": p.get("head_session_id"),
+                "mode": "interactive",
+                "current_task": None,
+                "status_note": f"Project Head for {p_name}",
+            }
+        for pt in p.get("principal_tags", []):
+            if pt and pt not in actors:
+                actors[pt] = {
+                    "tag": pt,
+                    "role": "Principal Monitor",
+                    "category": "coordinators",
+                    "project": "all",
+                    "session_id": None,
+                    "mode": "interactive",
+                    "current_task": None,
+                    "status_note": "Autonomous Principal Oversight",
+                }
+        po = p.get("principal_owner")
+        if po and po not in actors:
+            actors[po] = {
+                "tag": po,
+                "role": "Principal Monitor",
+                "category": "coordinators",
+                "project": "all",
+                "session_id": None,
+                "mode": "interactive",
+                "current_task": None,
+                "status_note": "Autonomous Principal Oversight",
+            }
+
+    # 2. Excluded Principals & Remote Orchestrators
+    for ep in reg.get("excluded_principals", []):
+        if ep and ep not in actors:
+            actors[ep] = {
+                "tag": ep,
+                "role": "Peer Principal",
+                "category": "coordinators",
+                "project": "all",
+                "session_id": None,
+                "mode": "interactive",
+                "current_task": None,
+                "status_note": "Peer Principal (Monitored)",
+            }
+
+    if "desktop-orchestrator" not in actors:
+        actors["desktop-orchestrator"] = {
+            "tag": "desktop-orchestrator",
+            "role": "Remote Orchestrator",
+            "category": "coordinators",
+            "project": "all",
+            "session_id": None,
+            "mode": "interactive",
+            "current_task": None,
+            "status_note": "Desktop / Remote Orchestration Interface",
+        }
+
+    # Helper to process agent/executor entries
+    def add_worker_entry(entry: Dict[str, Any], is_executor: bool) -> None:
+        tag = entry.get("tag")
+        if not tag or not isinstance(tag, str):
+            return
+
+        role = str(entry.get("role") or ("delivery-executor" if is_executor else "worker"))
+        raw_mode = str(entry.get("mode") or "headless")
+        raw_proj = entry.get("project_id") or entry.get("team_id")
+        proj = canonical_task_product(raw_proj)
+        session_id = entry.get("session_id")
+        task_id = entry.get("task_id")
+
+        # Check if this tag represents a coordinator
+        is_coord = (
+            "principal" in tag.lower()
+            or "head" in tag.lower()
+            or "orchestrator" in tag.lower()
+            or role.lower() in ("coordinator", "principal", "head")
+            or tag in ("public-journal-site", "desktop-orchestrator", "codex-principal", "claude-principal")
+        )
+        if is_coord:
+            if tag not in actors or actors[tag]["category"] != "coordinators":
+                actors[tag] = {
+                    "tag": tag,
+                    "role": role if role != "worker" else "Coordinator",
+                    "category": "coordinators",
+                    "project": proj,
+                    "session_id": session_id,
+                    "mode": raw_mode,
+                    "current_task": task_id,
+                    "status_note": "Persistent Coordinator",
+                }
+            return
+
+        # Determine worker state
+        task = tasks_by_id.get(task_id) if task_id else None
+        tstate = normalize_task_state(task.get("status") or task.get("state")) if task else None
+
+        first_action = entry.get("first_action") if isinstance(entry.get("first_action"), dict) else {}
+        selected = first_action.get("selected") if isinstance(first_action.get("selected"), dict) else {}
+        phase = str(selected.get("phase") or "").lower()
+        reported_state = str(selected.get("reported_state") or "").lower()
+
+        scope = str(entry.get("measurement_scope") or "").lower()
+        is_completed = (
+            "completed" in scope
+            or "ended" in scope
+            or tstate == "done"
+            or "ended_at" in entry
+        )
+        is_active = (
+            (tstate in ("in_progress", "review"))
+            or (phase == "running" and not is_completed)
+            or (reported_state == "working" and not is_completed)
+        )
+        is_blocked = (
+            (tstate == "blocked")
+            or (str(entry.get("assignment_status") or "").lower() == "blocked")
+        )
+
+        if is_active:
+            cat = "active_workers"
+            note = f"Active on task {task_id}" if task_id else "Active executing session"
+        elif is_completed:
+            cat = "completed_workers"
+            note = f"Completed task {task_id}" if task_id else "Completed run"
+        elif is_blocked:
+            cat = "idle_blocked"
+            note = f"Blocked on task {task_id}" if task_id else "Blocked session"
+        else:
+            cat = "idle_blocked"
+            note = f"Queued / idle for {task_id}" if task_id else "Idle session"
+
+        actors[tag] = {
+            "tag": tag,
+            "role": role,
+            "category": cat,
+            "project": proj,
+            "session_id": session_id,
+            "mode": raw_mode,
+            "current_task": task_id,
+            "status_note": note,
+        }
+
+    for a in reg.get("agents", []):
+        if isinstance(a, dict):
+            add_worker_entry(a, is_executor=False)
+    for d in reg.get("delivery_executors", []):
+        if isinstance(d, dict):
+            add_worker_entry(d, is_executor=True)
+
+    result: Dict[str, List[Dict[str, Any]]] = {
+        "coordinators": [],
+        "active_workers": [],
+        "completed_workers": [],
+        "idle_blocked": [],
+    }
+    for item in sorted(actors.values(), key=lambda x: str(x.get("tag", ""))):
+        cat = item["category"]
+        if cat in result:
+            result[cat].append(item)
+        else:
+            result["idle_blocked"].append(item)
+
+    return result
+
+
+def compute_task_summary(
+    tasks: List[Dict[str, Any]],
+    actors: Dict[str, List[Dict[str, Any]]],
+) -> Dict[str, Any]:
+    """Compute numerical summaries and metrics across products, states, and actors."""
+    total = len(tasks)
+    by_product: Dict[str, Dict[str, Any]] = {}
+    for prod in CANONICAL_TASK_PRODUCTS:
+        by_product[prod] = {
+            "total": 0,
+            "done": 0,
+            "in_progress": 0,
+            "review": 0,
+            "blocked": 0,
+            "ready": 0,
+            "completion_pct": 0.0,
+        }
+
+    by_state: Dict[str, int] = {st: 0 for st in VALID_TASK_STATES}
+    by_priority: Dict[str, int] = {"critical": 0, "high": 0, "normal": 0, "low": 0}
+
+    for t in tasks:
+        prod = t["product"]
+        st = t["state"]
+        prio = t["priority"]
+
+        if prod not in by_product:
+            by_product[prod] = {
+                "total": 0,
+                "done": 0,
+                "in_progress": 0,
+                "review": 0,
+                "blocked": 0,
+                "ready": 0,
+                "completion_pct": 0.0,
+            }
+        by_product[prod]["total"] += 1
+        if st in by_product[prod]:
+            by_product[prod][st] += 1
+
+        if st in by_state:
+            by_state[st] += 1
+        else:
+            by_state["ready"] += 1
+
+        if prio in by_priority:
+            by_priority[prio] += 1
+        else:
+            by_priority["normal"] += 1
+
+    for prod_info in by_product.values():
+        p_total = prod_info["total"]
+        p_done = prod_info["done"]
+        prod_info["completion_pct"] = round((p_done / p_total) * 100.0, 1) if p_total > 0 else 0.0
+
+    overall_pct = round((by_state["done"] / total) * 100.0, 1) if total > 0 else 0.0
+
+    return {
+        "total_tasks": total,
+        "overall_completion_pct": overall_pct,
+        "by_product": by_product,
+        "by_state": by_state,
+        "by_priority": by_priority,
+        "actor_counts": {k: len(v) for k, v in actors.items()},
+    }
+
+
+def load_tasks_payload(
+    tasks_path: Optional[str] = None,
+    backlog_path: Optional[str] = None,
+    registry_path: Optional[str] = None,
+    as_of: Optional[datetime.datetime] = None,
+) -> Dict[str, Any]:
+    """
+    Load canonical task data, join with backlog requirements, categorize actors,
+    and return complete task tracker payload with sources and coverage gaps.
+    """
+    coverage_gaps: List[Dict[str, str]] = []
+    sources: Dict[str, Any] = {}
+
+    default_tasks = "/home/alexey/git/cloudflare-agent-git/coordination/TASKS.json"
+    default_backlog = "/home/alexey/git/cloudflare-agent-git/coordination/DELIVERY-BACKLOG.json"
+    default_reg = "/home/alexey/git/cloudflare-agent-git/coordination/TEAM-REGISTRY.json"
+
+    t_path = tasks_path or os.environ.get("TASKS_JSON_PATH", default_tasks)
+    b_path = backlog_path or os.environ.get("DELIVERY_BACKLOG_PATH", default_backlog)
+    r_path = registry_path or os.environ.get("TEAM_REGISTRY_PATH", default_reg)
+
+    # 1. Load TASKS.json
+    raw_tasks_list: List[Dict[str, Any]] = []
+    tasks_readable = bool(t_path and os.path.isfile(t_path) and os.access(t_path, os.R_OK))
+    sources["tasks"] = {"kind": "task-ledger", "path": t_path, "readable": tasks_readable}
+    if tasks_readable:
+        try:
+            with open(t_path, "r", encoding="utf-8") as f:
+                data = json.load(f)
+            if isinstance(data, dict) and isinstance(data.get("tasks"), list):
+                raw_tasks_list = [x for x in data["tasks"] if isinstance(x, dict)]
+            elif isinstance(data, list):
+                raw_tasks_list = [x for x in data if isinstance(x, dict)]
+            else:
+                coverage_gaps.append({"source": t_path, "reason": "invalid JSON schema: expected dict with tasks array"})
+        except Exception as e:
+            coverage_gaps.append({"source": t_path, "reason": f"error reading tasks: {e}"})
+    else:
+        coverage_gaps.append({"source": t_path, "reason": "TASKS.json missing or unreadable"})
+
+    # 2. Load DELIVERY-BACKLOG.json
+    backlog_data: Dict[str, Any] = {}
+    backlog_readable = bool(b_path and os.path.isfile(b_path) and os.access(b_path, os.R_OK))
+    sources["backlog"] = {"kind": "delivery-backlog", "path": b_path, "readable": backlog_readable}
+    if backlog_readable:
+        try:
+            with open(b_path, "r", encoding="utf-8") as f:
+                backlog_data = json.load(f)
+        except Exception as e:
+            coverage_gaps.append({"source": b_path, "reason": f"error reading backlog: {e}"})
+    else:
+        coverage_gaps.append({"source": b_path, "reason": "DELIVERY-BACKLOG.json missing or unreadable"})
+
+    # Map human sources by task_id
+    task_to_human_source: Dict[str, Dict[str, Any]] = {}
+    delivery_task_ids: Set[str] = set()
+    if isinstance(backlog_data, dict):
+        for hs in backlog_data.get("human_sources", []):
+            if isinstance(hs, dict):
+                for tid in hs.get("task_ids", []):
+                    if tid and tid not in task_to_human_source:
+                        task_to_human_source[tid] = hs
+        for dtid in backlog_data.get("new_delivery_task_ids", []):
+            if isinstance(dtid, str):
+                delivery_task_ids.add(dtid)
+
+    # 3. Load TEAM-REGISTRY.json
+    registry_data: Dict[str, Any] = {}
+    reg_readable = bool(r_path and os.path.isfile(r_path) and os.access(r_path, os.R_OK))
+    sources["registry"] = {"kind": "team-registry", "path": r_path, "readable": reg_readable}
+    if reg_readable:
+        try:
+            with open(r_path, "r", encoding="utf-8") as f:
+                registry_data = json.load(f)
+        except Exception as e:
+            coverage_gaps.append({"source": r_path, "reason": f"error reading registry: {e}"})
+    else:
+        coverage_gaps.append({"source": r_path, "reason": "TEAM-REGISTRY.json missing or unreadable"})
+
+    # Build tasks_by_id index for actor categorization
+    tasks_by_id: Dict[str, Dict[str, Any]] = {}
+    for rt in raw_tasks_list:
+        tid = rt.get("id")
+        if tid:
+            tasks_by_id[str(tid)] = rt
+
+    # Categorize fleet actors
+    actors = categorize_actors(registry_data, tasks_by_id)
+
+    # Transform raw tasks into structured task objects
+    structured_tasks: List[Dict[str, Any]] = []
+    for rt in raw_tasks_list:
+        task_id = str(rt.get("id") or "unspecified")
+        hs = task_to_human_source.get(task_id)
+
+        product = canonical_task_product(rt.get("project_id"), rt.get("team_id"))
