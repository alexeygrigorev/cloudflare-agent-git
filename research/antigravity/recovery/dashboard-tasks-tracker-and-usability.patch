+
+  var toggleKanban = document.getElementById("toggle-kanban");
+  var toggleList = document.getElementById("toggle-list");
+  if (toggleKanban && toggleList) {
+    toggleKanban.addEventListener("click", function () {
+      currentFilter.view = "kanban";
