+/* =========================================================================
+ * MODAL DIALOG
+ * ========================================================================= */
+function openTaskModal(task) {
+  var modal = document.getElementById("task-modal");
+  if (!modal || !task) return;
+
+  var titleEl = document.getElementById("modal-task-title");
+  if (titleEl) titleEl.textContent = task.title || task.id;
+
+  var badgesEl = document.getElementById("modal-badges");
+  if (badgesEl) {
+    badgesEl.innerHTML =
+      '<span class="badge" style="color:' + (STATE_COLORS[task.state] || '#fff') + '; border-color:' + (STATE_COLORS[task.state] || '#fff') + ';">' + (STATE_LABELS[task.state] || task.state) + '</span> ' +
+      '<span class="badge-prod">' + task.product + '</span> ' +
+      '<span class="badge-prio prio-' + (task.priority || 'normal') + '">' + (task.priority || 'normal') + '</span>';
+  }
+
+  setCell("modal-id", { text: task.id });
+  setCell("modal-product", { text: task.product });
+  setCell("modal-state", { text: STATE_LABELS[task.state] || task.state });
+  setCell("modal-priority", { text: task.priority || "normal" });
+  setCell("modal-owner", { text: task.owner || "unassigned" });
+  setCell("modal-update", { text: fmtTime(task.last_update) });
+
+  var descEl = document.getElementById("modal-description");
+  if (descEl) descEl.textContent = task.description || "No description provided.";
+
+  var nextSec = document.getElementById("modal-section-next");
+  var nextEl = document.getElementById("modal-next-action");
+  if (nextSec && nextEl) {
+    if (task.next_action) {
+      nextSec.hidden = false;
+      nextEl.textContent = task.next_action;
+    } else {
+      nextSec.hidden = true;
+    }
+  }
+
+  var blockerSec = document.getElementById("modal-section-blocker");
+  var blockerEl = document.getElementById("modal-blocker");
+  if (blockerSec && blockerEl) {
+    if (task.blocker && task.blocker.length > 0) {
+      blockerSec.hidden = false;
+      var bList = Array.isArray(task.blocker) ? task.blocker.join("; ") : String(task.blocker);
+      blockerEl.textContent = bList;
+    } else {
+      blockerSec.hidden = true;
+    }
+  }
+
+  var evSec = document.getElementById("modal-section-evidence");
+  var evEl = document.getElementById("modal-evidence");
+  if (evSec && evEl) {
+    if (task.outcome_evidence && (Array.isArray(task.outcome_evidence) ? task.outcome_evidence.length > 0 : true)) {
+      evSec.hidden = false;
+      if (Array.isArray(task.outcome_evidence)) {
+        evEl.innerHTML = task.outcome_evidence.map(function (e) { return '<div>• <code>' + e + '</code></div>'; }).join("");
+      } else {
+        evEl.textContent = String(task.outcome_evidence);
+      }
+    } else {
+      evSec.hidden = true;
+    }
+  }
+
+  var reviewSec = document.getElementById("modal-section-review");
+  var reviewEl = document.getElementById("modal-review");
+  if (reviewSec && reviewEl) {
+    var rParts = [];
+    if (task.reviewer) rParts.push("Reviewer: " + task.reviewer);
+    if (task.commit) rParts.push("Commit: " + task.commit);
+    if (task.tests) rParts.push("Tests: " + task.tests);
+    if (rParts.length > 0) {
+      reviewSec.hidden = false;
+      reviewEl.textContent = rParts.join(" · ");
+    } else {
+      reviewSec.hidden = true;
+    }
+  }
+
+  var rawEl = document.getElementById("modal-raw-json");
+  if (rawEl) {
+    rawEl.textContent = JSON.stringify(task.raw || task, null, 2);
+  }
+
+  modal.hidden = false;
+  document.body.style.overflow = "hidden";
+}
+
+function closeTaskModal() {
+  var modal = document.getElementById("task-modal");
+  if (modal) {
+    modal.hidden = true;
+    document.body.style.overflow = "";
+  }
+}
