+/* =========================================================================
+ * ACTORS & SESSIONS RENDERING
+ * ========================================================================= */
+function renderActors(payload) {
+  var actors = (payload && payload.actors) || {};
+
+  var cats = [
+    { key: "coordinators", hostId: "actors-coordinators-list", badgeId: "count-actors-coordinators" },
+    { key: "active_workers", hostId: "actors-active-list", badgeId: "count-actors-active" },
+    { key: "completed_workers", hostId: "actors-completed-list", badgeId: "count-actors-completed" },
+    { key: "idle_blocked", hostId: "actors-idle-list", badgeId: "count-actors-idle" }
+  ];
+
+  var totalActors = 0;
+
+  cats.forEach(function (c) {
+    var list = actors[c.key] || [];
+    totalActors += list.length;
+    var host = document.getElementById(c.hostId);
+    var badge = document.getElementById(c.badgeId);
+    if (badge) badge.textContent = String(list.length);
+    if (!host) return;
+    host.textContent = "";
+
+    if (list.length === 0) {
+      host.innerHTML = '<p class="muted small">No actors in this category.</p>';
+      return;
+    }
+
+    list.forEach(function (a) {
+      var item = document.createElement("div");
+      item.className = "actor-item";
+
+      var top = document.createElement("div");
+      top.className = "actor-item-top";
+
+      var tagSpan = document.createElement("span");
+      tagSpan.className = "actor-tag";
+      tagSpan.textContent = a.tag;
+      top.appendChild(tagSpan);
+
+      var roleSpan = document.createElement("span");
+      roleSpan.className = "actor-role";
+      roleSpan.textContent = a.role;
+      top.appendChild(roleSpan);
+
+      item.appendChild(top);
+
+      var note = document.createElement("div");
+      note.className = "actor-note";
+      note.textContent = a.status_note || "Operational";
+      item.appendChild(note);
+
+      var sub = document.createElement("div");
+      sub.className = "actor-sub";
+      var subParts = [];
+      if (a.project) subParts.push("project: " + a.project);
+      if (a.mode) subParts.push("mode: " + a.mode);
+      if (a.session_id) subParts.push("session: " + a.session_id.substring(0, 8) + "…");
+      if (a.current_task) subParts.push("task: " + a.current_task);
+      sub.textContent = subParts.join(" · ");
+      item.appendChild(sub);
+
+      host.appendChild(item);
+    });
+  });
+
+  var navBadge = document.getElementById("nav-actors-badge");
+  if (navBadge) navBadge.textContent = String(totalActors);
+}
