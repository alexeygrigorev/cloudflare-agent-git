+
+        coord_tags = [a["tag"] for a in actors["coordinators"]]
+        self.assertIn("antigravity-head", coord_tags)
+        self.assertIn("agent-dashboard-head", coord_tags)
+        self.assertIn("codex-principal", coord_tags)
+        self.assertIn("claude-principal", coord_tags)
+        self.assertIn("desktop-orchestrator", coord_tags)
+
+        active_tags = [a["tag"] for a in actors["active_workers"]]
+        self.assertIn("ab-worker-1", active_tags)
+
+        completed_tags = [a["tag"] for a in actors["completed_workers"]]
+        self.assertIn("old-completed-worker", completed_tags)
+
+        idle_tags = [a["tag"] for a in actors["idle_blocked"]]
+        self.assertIn("launcher-worker-2", idle_tags)
+
+        # Check disjointness across all categories
+        all_tags = []
+        for cat in ("coordinators", "active_workers", "completed_workers", "idle_blocked"):
+            tags = [a["tag"] for a in actors[cat]]
+            for t in tags:
+                self.assertNotIn(t, all_tags, f"Tag {t} appears in multiple actor categories")
+                all_tags.append(t)
