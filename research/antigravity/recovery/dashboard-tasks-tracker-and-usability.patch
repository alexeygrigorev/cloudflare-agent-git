+        self.assertEqual(len(payload["tasks"]), 1)
+        self.assertEqual(payload["tasks"][0]["id"], "task-launcher-blocked")
+
+        # Owner filter
+        _status, payload = self._get_json("/api/tasks?owner=ab-worker")
+        self.assertEqual(len(payload["tasks"]), 1)
+        self.assertEqual(payload["tasks"][0]["id"], "task-ab-1")
+
+    def test_missing_tasks_file_graceful_handling(self):
+        old = os.environ.get("TASKS_JSON_PATH")
+        os.environ["TASKS_JSON_PATH"] = os.path.join(self.scratch, "nonexistent-tasks.json")
+        try:
+            status, payload = self._get_json("/api/tasks")
+            self.assertEqual(status, 200)
+            self.assertTrue(payload["unknown"])
+            self.assertEqual(len(payload["tasks"]), 0)
+            self.assertTrue(any("nonexistent-tasks.json" in g.get("source", "") for g in payload["coverage_gaps"]))
+        finally:
+            if old is None:
+                os.environ.pop("TASKS_JSON_PATH", None)
+            else:
+                os.environ["TASKS_JSON_PATH"] = old
