+function renderTasksDonutChart(summary) {
+  var host = document.getElementById("chart-tasks-donut");
+  var legendHost = document.getElementById("donut-legend");
+  if (!host) return;
+  host.textContent = "";
+  if (legendHost) legendHost.textContent = "";
+
+  var byState = (summary && summary.by_state) || {};
+  var total = (summary && summary.total_tasks) || 0;
+
+  if (total <= 0) {
+    host.innerHTML = '<p class="muted">no task data available</p>';
+    return;
+  }
+
+  var size = 160;
+  var strokeWidth = 26;
+  var radius = (size - strokeWidth) / 2;
+  var circumference = 2 * Math.PI * radius;
+  var cx = size / 2;
+  var cy = size / 2;
+
+  var svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
+  svg.setAttribute("viewBox", "0 0 " + size + " " + size);
+  svg.setAttribute("width", "160");
+  svg.setAttribute("height", "160");
+
+  var currentOffset = 0;
+
+  TASK_STATES.forEach(function (st) {
+    var count = byState[st] || 0;
+    if (count <= 0) return;
+    var fraction = count / total;
+    var dash = fraction * circumference;
+    var gap = circumference - dash;
+
+    var circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
+    circle.setAttribute("cx", String(cx));
+    circle.setAttribute("cy", String(cy));
+    circle.setAttribute("r", String(radius));
+    circle.setAttribute("fill", "transparent");
+    circle.setAttribute("stroke", STATE_COLORS[st] || "#64748b");
+    circle.setAttribute("stroke-width", String(strokeWidth));
+    circle.setAttribute("stroke-dasharray", dash + " " + gap);
+    circle.setAttribute("stroke-dashoffset", String(-currentOffset));
+    circle.setAttribute("transform", "rotate(-90 " + cx + " " + cy + ")");
+
+    var title = document.createElementNS("http://www.w3.org/2000/svg", "title");
+    title.textContent = STATE_LABELS[st] + ": " + count + " (" + Math.round(fraction * 100) + "%)";
+    circle.appendChild(title);
+
+    svg.appendChild(circle);
+    currentOffset += dash;
+  });
+
+  // Center text (Overall completion & Total tasks)
+  var textPct = document.createElementNS("http://www.w3.org/2000/svg", "text");
+  textPct.setAttribute("x", String(cx));
+  textPct.setAttribute("y", String(cy - 2));
+  textPct.setAttribute("text-anchor", "middle");
+  textPct.setAttribute("dominant-baseline", "middle");
+  textPct.setAttribute("fill", "#34d399");
+  textPct.setAttribute("font-size", "22");
+  textPct.setAttribute("font-weight", "800");
+  textPct.textContent = ((summary && summary.overall_completion_pct) || 0) + "%";
+  svg.appendChild(textPct);
+
+  var textSub = document.createElementNS("http://www.w3.org/2000/svg", "text");
+  textSub.setAttribute("x", String(cx));
+  textSub.setAttribute("y", String(cy + 18));
+  textSub.setAttribute("text-anchor", "middle");
+  textSub.setAttribute("fill", "#94a3b8");
+  textSub.setAttribute("font-size", "10");
+  textSub.textContent = total + " tasks";
+  svg.appendChild(textSub);
+
+  host.appendChild(svg);
+
+  // Render legend
+  if (legendHost) {
+    TASK_STATES.forEach(function (st) {
+      var count = byState[st] || 0;
+      var pct = total > 0 ? Math.round((count / total) * 100) : 0;
+      var item = document.createElement("span");
+      item.className = "legend-item";
+      item.innerHTML =
+        '<span class="legend-dot" style="background-color: ' + STATE_COLORS[st] + ';"></span>' +
+        '<span>' + STATE_LABELS[st] + ': <strong>' + count + '</strong> (' + pct + '%)</span>';
+      legendHost.appendChild(item);
+    });
+  }
