+function filterTasks(tasks) {
+  if (!Array.isArray(tasks)) return [];
+
+  var q = (currentFilter.search || "").toLowerCase().trim();
+  var prod = currentFilter.product;
+  var state = currentFilter.state;
+  var owner = currentFilter.owner;
+  var prio = currentFilter.priority;
+
+  return tasks.filter(function (t) {
+    if (!t) return false;
+    if (prod && t.product !== prod) return false;
+    if (state && t.state !== state) return false;
+    if (owner && t.owner !== owner) return false;
+    if (prio && t.priority !== prio) return false;
+
+    if (q) {
+      var matchId = (t.id || "").toLowerCase().indexOf(q) !== -1;
+      var matchTitle = (t.title || "").toLowerCase().indexOf(q) !== -1;
+      var matchDesc = (t.description || "").toLowerCase().indexOf(q) !== -1;
+      var matchOwner = (t.owner || "").toLowerCase().indexOf(q) !== -1;
+      var matchNext = (t.next_action || "").toLowerCase().indexOf(q) !== -1;
+      if (!matchId && !matchTitle && !matchDesc && !matchOwner && !matchNext) {
+        return false;
+      }
+    }
+    return true;
+  });
